    "# ===== SAVE MODEL AND RESULTS =====\n",
    "\n",
    "def save_bertopic_model(topic_model: BERTopic, \n",
    "                       df: pd.DataFrame, \n",
    "                       embeddings: np.ndarray,\n",
    "                       save_dir: str = \"saved_models/bertopic_gpu\") -> str:\n",
    "    \"\"\"Save BERTopic model and associated data\"\"\"\n",
    "    \n",
    "    os.makedirs(save_dir, exist_ok=True)\n",
    "    \n",
    "    timestamp = datetime.now().strftime('%Y%m%d_%H%M')\n",
    "    \n",
    "    # Save BERTopic model\n",
    "    model_path = os.path.join(save_dir, f\"bertopic_model_{timestamp}\")\n",
    "    topic_model.save(model_path)\n",
    "    \n",
    "    # Save embeddings\n",
    "    embeddings_path = os.path.join(save_dir, f\"embeddings_{timestamp}.npy\")\n",
    "    np.save(embeddings_path, embeddings)\n",
    "    \n",
    "    # Save dataframe with topics\n",
    "    df_path = os.path.join(save_dir, f\"songs_with_topics_{timestamp}.csv\")\n",
    "    df.to_csv(df_path, index=False)\n",
    "    \n",
    "    # Save topic information\n",
    "    topic_info = topic_model.get_topic_info()\n",
    "    topic_info_path = os.path.join(save_dir, f\"topic_info_{timestamp}.csv\")\n",
    "    topic_info.to_csv(topic_info_path, index=False)\n",
    "    \n",
    "    # Save metadata\n",
    "    metadata = {\n",
    "        'timestamp': timestamp,\n",
    "        'n_documents': len(df),\n",
    "        'n_topics': len(topic_info) - 1,\n",
    "        'embedding_model': 'all-MiniLM-L6-v2',\n",
    "        'device_used': str(device),\n",
    "        'gpu_memory_gb': gpu_memory_gb,\n",
    "        'batch_size': optimal_batch_size\n",
    "    }\n",
    "    \n",
    "    metadata_path = os.path.join(save_dir, f\"metadata_{timestamp}.json\")\n",
    "    with open(metadata_path, 'w') as f:\n",
    "        json.dump(metadata, f, indent=2)\n",
    "    \n",
    "    print(f\"💾 Model saved to: {save_dir}\")\n",
    "    print(f\"   Model: {model_path}\")\n",
    "    print(f\"   Embeddings: {embeddings_path}\")\n",
    "    print(f\"   Data: {df_path}\")\n",
    "    print(f\"   Topic Info: {topic_info_path}\")\n",
    "    print(f\"   Metadata: {metadata_path}\")\n",
    "    \n",
    "    return model_path\n",
    "\n",
    "# Save the model\n",
    "model_path = save_bertopic_model(topic_model, df, embeddings)\n",
    "\n",
    "# Final cleanup\n",
    "clear_gpu_memory()\n",
    "print(f\"\\n📊 {get_gpu_memory_usage()}\")"
