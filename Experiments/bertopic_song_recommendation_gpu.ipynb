    "# ===== GPU SETUP AND DETECTION =====\n",
    "\n",
    "import torch\n",
    "import os\n",
    "import psutil\n",
    "import gc\n",
    "import numpy as np\n",
    "from typing import Optional, List, Tuple\n",
    "\n",
    "def setup_gpu_environment():\n",
    "    \"\"\"Setup GPU environment with BERTopic optimizations\"\"\"\n",
    "    cuda_available = torch.cuda.is_available()\n",
    "    device_count = torch.cuda.device_count()\n",
    "    \n",
    "    print(\"🖥️  GPU Environment Setup for BERTopic:\")\n",
    "    print(f\"   CUDA Available: {cuda_available}\")\n",
    "    \n",
    "    if cuda_available:\n",
    "        print(f\"   GPU Device Count: {device_count}\")\n",
    "        for i in range(device_count):\n",
    "            gpu_name = torch.cuda.get_device_name(i)\n",
    "            gpu_memory = torch.cuda.get_device_properties(i).total_memory / 1024**3\n",
    "            print(f\"   GPU {i}: {gpu_name} ({gpu_memory:.1f} GB)\")\n",
    "        \n",
    "        # Optimize for BERTopic workloads\n",
    "        torch.cuda.empty_cache()\n",
    "        torch.cuda.set_per_process_memory_fraction(0.9)  # More aggressive for BERTopic\n",
    "        \n",
    "        device = torch.device(\"cuda\")\n",
    "        print(f\"   ✅ Using GPU: {torch.cuda.get_device_name(0)}\")\n",
    "    else:\n",
    "        device = torch.device(\"cpu\")\n",
    "        print(\"   ⚠️  CUDA not available. Using CPU.\")\n",
    "        print(\"   💡 Install GPU PyTorch: pip install torch --index-url https://download.pytorch.org/whl/cu118\")\n",
    "    \n",
    "    # Set optimal environment variables\n",
    "    os.environ['TOKENIZERS_PARALLELISM'] = 'false'\n",
    "    os.environ['PYTORCH_CUDA_ALLOC_CONF'] = 'max_split_size_mb:128'\n",
    "    \n",
    "    return device, cuda_available\n",
    "\n",
    "def get_optimal_batch_size(cuda_available: bool, gpu_memory_gb: float = 0) -> int:\n",
    "    \"\"\"Get optimal batch size based on hardware\"\"\"\n",
    "    if not cuda_available:\n",
    "        return 16\n",
    "    \n",
    "    if gpu_memory_gb < 4:\n",
    "        return 8\n",
    "    elif gpu_memory_gb < 8:\n",
    "        return 16\n",
    "    elif gpu_memory_gb < 12:\n",
    "        return 32\n",
    "    else:\n",
    "        return 64\n",
    "\n",
    "def clear_gpu_memory():\n",
    "    \"\"\"Clear GPU memory and run garbage collection\"\"\"\n",
    "    if torch.cuda.is_available():\n",
    "        torch.cuda.empty_cache()\n",
    "        torch.cuda.synchronize()\n",
    "    gc.collect()\n",
    "    print(\"🧹 Memory cleared\")\n",
    "\n",
    "def get_gpu_memory_usage():\n",
    "    \"\"\"Get current GPU memory usage\"\"\"\n",
    "    if torch.cuda.is_available():\n",
    "        allocated = torch.cuda.memory_allocated() / 1024**3\n",
    "        reserved = torch.cuda.memory_reserved() / 1024**3\n",
    "        return f\"GPU Memory - Allocated: {allocated:.2f} GB, Reserved: {reserved:.2f} GB\"\n",
    "    return \"GPU not available\"\n",
    "\n",
    "# Initialize GPU environment\n",
    "device, cuda_available = setup_gpu_environment()\n",
    "if cuda_available:\n",
    "    gpu_memory_gb = torch.cuda.get_device_properties(0).total_memory / 1024**3\n",
    "    optimal_batch_size = get_optimal_batch_size(cuda_available, gpu_memory_gb)\n",
    "    print(f\"\\n🎯 Optimal batch size: {optimal_batch_size}\")\n",
    "else:\n",
    "    gpu_memory_gb = 0\n",
    "    optimal_batch_size = 16\n",
    "\n",
    "print(f\"\\n📊 Device: {device}\")\n",
    "print(f\"📊 {get_gpu_memory_usage()}\")"
   ]
  },
