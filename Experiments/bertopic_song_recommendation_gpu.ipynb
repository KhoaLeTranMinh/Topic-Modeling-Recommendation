    "# ===== GPU-ACCELERATED BERTOPIC TRAINING =====\n",
    "\n",
    "def create_gpu_bertopic_model(min_topic_size: int = 15,\n",
    "                             n_neighbors: int = 15,\n",
    "                             n_components: int = 5,\n",
    "                             min_cluster_size: int = 15) -> BERTopic:\n",
    "    \"\"\"Create BERTopic model with GPU-accelerated components\"\"\"\n",
    "    \n",
    "    print(f\"🚀 Creating GPU-accelerated BERTopic model...\")\n",
    "    print(f\"   Min topic size: {min_topic_size}\")\n",
    "    print(f\"   UMAP n_neighbors: {n_neighbors}\")\n",
    "    print(f\"   UMAP n_components: {n_components}\")\n",
    "    \n",
    "    # GPU-accelerated UMAP if available\n",
    "    try:\n",
    "        if cuda_available:\n",
    "            umap_model = cuml_manifold.UMAP(\n",
    "                n_neighbors=n_neighbors,\n",
    "                n_components=n_components,\n",
    "                min_dist=0.0,\n",
    "                metric='cosine',\n",
    "                random_state=42\n",
    "            )\n",
    "            print(\"   ✅ Using GPU-accelerated UMAP\")\n",
    "        else:\n",
    "            raise ImportError(\"cuML not available\")\n",
    "    except ImportError:\n",
    "        umap_model = UMAP(\n",
    "            n_neighbors=n_neighbors,\n",
    "            n_components=n_components,\n",
    "            min_dist=0.0,\n",
    "            metric='cosine',\n",
    "            random_state=42,\n",
    "            low_memory=False\n",
    "        )\n",
    "        print(\"   ⚠️  Using CPU UMAP\")\n",
    "    \n",
    "    # GPU-accelerated clustering if available\n",
    "    try:\n",
    "        if cuda_available:\n",
    "            hdbscan_model = cuml_cluster.HDBSCAN(\n",
    "                min_cluster_size=min_cluster_size,\n",
    "                metric='euclidean',\n",
    "                cluster_selection_method='eom'\n",
    "            )\n",
    "            print(\"   ✅ Using GPU-accelerated HDBSCAN\")\n",
    "        else:\n",
    "            raise ImportError(\"cuML not available\")\n",
    "    except ImportError:\n",
    "        hdbscan_model = HDBSCAN(\n",
    "            min_cluster_size=min_cluster_size,\n",
    "            metric='euclidean',\n",
    "            cluster_selection_method='eom',\n",
    "            prediction_data=True\n",
    "        )\n",
    "        print(\"   ⚠️  Using CPU HDBSCAN\")\n",
    "    \n",
    "    # Vectorizer for better topic representation\n",
    "    vectorizer_model = ClassTfidfTransformer(reduce_frequent_words=True)\n",
    "    \n",
    "    # Create BERTopic model\n",
    "    topic_model = BERTopic(\n",
    "        umap_model=umap_model,\n",
    "        hdbscan_model=hdbscan_model,\n",
    "        vectorizer_model=vectorizer_model,\n",
    "        min_topic_size=min_topic_size,\n",
    "        nr_topics=\"auto\",\n",
    "        calculate_probabilities=True,\n",
    "        verbose=True\n",
    "    )\n",
    "    \n",
    "    return topic_model\n",
    "\n",
    "def train_bertopic_gpu(topic_model: BERTopic, \n",
    "                      documents: List[str], \n",
    "                      embeddings: np.ndarray) -> Tuple[BERTopic, List[int]]:\n",
    "    \"\"\"Train BERTopic model with GPU acceleration\"\"\"\n",
    "    \n",
    "    print(f\"🎯 Training BERTopic on {len(documents):,} documents...\")\n",
    "    \n",
    "    # Clear GPU memory before training\n",
    "    clear_gpu_memory()\n",
    "    \n",
    "    start_time = time.time()\n",
    "    \n",
    "    # Train the model\n",
    "    topics, probs = topic_model.fit_transform(documents, embeddings)\n",
    "    \n",
    "    end_time = time.time()\n",
    "    \n",
    "    # Get topic info\n",
    "    topic_info = topic_model.get_topic_info()\n",
    "    n_topics = len(topic_info) - 1  # Exclude outlier topic (-1)\n",
    "    \n",
    "    print(f\"   ✅ Training completed in {end_time - start_time:.1f} seconds\")\n",
    "    print(f\"   📊 Discovered {n_topics} topics\")\n",
    "    print(f\"   📊 Outliers: {sum(1 for t in topics if t == -1):,} documents\")\n",
    "    \n",
    "    return topic_model, topics\n",
    "\n",
    "# Optimize parameters based on GPU memory\n",
    "if gpu_memory_gb < 4:\n",
    "    min_topic_size = 20\n",
    "    n_neighbors = 10\n",
    "    n_components = 3\n",
    "elif gpu_memory_gb < 8:\n",
    "    min_topic_size = 15\n",
    "    n_neighbors = 15\n",
    "    n_components = 5\n",
    "else:\n",
    "    min_topic_size = 10\n",
    "    n_neighbors = 20\n",
    "    n_components = 5\n",
    "\n",
    "# Create and train BERTopic model\n",
    "topic_model = create_gpu_bertopic_model(\n",
    "    min_topic_size=min_topic_size,\n",
    "    n_neighbors=n_neighbors,\n",
    "    n_components=n_components\n",
    ")\n",
    "\n",
    "topic_model, topics = train_bertopic_gpu(topic_model, processed_lyrics, embeddings)\n",
    "\n",
    "# Add topics to dataframe\n",
    "df['topic'] = topics\n",
    "\n",
    "print(f\"\\n📊 {get_gpu_memory_usage()}\")"
   ]
