    "    )\n",
    "    \n",
    "    end_time = time.time()\n",
    "    \n",
    "    print(f\"   ✅ Embeddings created in {end_time - start_time:.1f} seconds\")\n",
    "    print(f\"   📊 Shape: {embeddings.shape}\")\n",
    "    print(f\"   📊 Size: {embeddings.nbytes / 1024**2:.1f} MB\")\n",
    "    \n",
    "    # Clean up model to free GPU memory\n",
    "    del embedding_model\n",
    "    clear_gpu_memory()\n",
    "    \n",
    "    return embeddings\n",
    "\n",
    "# Create embeddings\n",
