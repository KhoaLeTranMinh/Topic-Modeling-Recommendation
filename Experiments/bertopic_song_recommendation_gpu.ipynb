    "# ===== TOPIC ANALYSIS AND VISUALIZATION =====\n",
    "\n",
    "def analyze_topics(topic_model: BERTopic, topics: List[int]) -> None:\n",
    "    \"\"\"Analyze and visualize discovered topics\"\"\"\n",
    "    \n",
    "    print(\"📊 Topic Analysis:\")\n",
    "    \n",
    "    # Get topic information\n",
    "    topic_info = topic_model.get_topic_info()\n",
    "    print(f\"   Total topics: {len(topic_info)}\")\n",
    "    print(f\"   Valid topics: {len(topic_info) - 1}\")\n",
    "    \n",
    "    # Display top topics\n",
    "    print(\"\\n🔝 Top 10 Topics:\")\n",
    "    for i, row in topic_info.head(10).iterrows():\n",
    "        if row['Topic'] != -1:\n",
    "            topic_words = topic_model.get_topic(row['Topic'])\n",
    "            top_words = [word for word, _ in topic_words[:5]]\n",
    "            print(f\"   Topic {row['Topic']:2d}: {', '.join(top_words)} (Count: {row['Count']})\")\n",
    "    \n",
    "    # Topic distribution\n",
    "    topic_counts = Counter(topics)\n",
    "    outlier_count = topic_counts.get(-1, 0)\n",
    "    valid_topics = {k: v for k, v in topic_counts.items() if k != -1}\n",
    "    \n",
    "    print(f\"\\n📈 Topic Distribution:\")\n",
    "    print(f\"   Outliers (-1): {outlier_count:,} ({outlier_count/len(topics)*100:.1f}%)\")\n",
    "    print(f\"   Valid topics: {len(valid_topics):,}\")\n",
    "    print(f\"   Largest topic: {max(valid_topics.values()) if valid_topics else 0:,} documents\")\n",
