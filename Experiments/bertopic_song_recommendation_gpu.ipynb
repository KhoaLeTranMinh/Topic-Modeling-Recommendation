    "# ===== DATA LOADING AND PREPROCESSING =====\n",
    "\n",
    "def load_and_preprocess_data(data_path: str, sample_size: Optional[int] = None) -> pd.DataFrame:\n",
    "    \"\"\"Load and preprocess song data with GPU optimization\"\"\"\n",
    "    print(f\"📂 Loading data from: {data_path}\")\n",
    "    \n",
    "    # Load data\n",
    "    df = pd.read_csv(data_path)\n",
    "    \n",
    "    # Sample data if specified (for testing)\n",
    "    if sample_size and len(df) > sample_size:\n",
    "        df = df.sample(n=sample_size, random_state=42)\n",
    "        print(f\"📊 Sampled {sample_size} songs for testing\")\n",
    "    \n",
    "    # Basic preprocessing\n",
    "    df = df.dropna(subset=['lyrics', 'artist', 'song_title'])\n",
    "    df['lyrics'] = df['lyrics'].astype(str)\n",
    "    \n",
    "    # Filter out very short lyrics\n",
    "    df = df[df['lyrics'].str.len() > 100]\n",
    "    \n",
    "    print(f\"📊 Dataset loaded:\")\n",
    "    print(f\"   Songs: {len(df):,}\")\n",
    "    print(f\"   Artists: {df['artist'].nunique():,}\")\n",
    "    print(f\"   Average lyric length: {df['lyrics'].str.len().mean():.0f} characters\")\n",
    "    \n",
    "    return df\n",
    "\n",
    "def preprocess_lyrics(lyrics: List[str], batch_size: int = 1000) -> List[str]:\n",
    "    \"\"\"Preprocess lyrics with batch processing for GPU efficiency\"\"\"\n",
    "    print(f\"🔄 Preprocessing {len(lyrics):,} lyrics...\")\n",
    "    \n",
    "    stop_words = set(stopwords.words('english'))\n",
    "    lemmatizer = WordNetLemmatizer()\n",
    "    \n",
    "    def clean_text(text):\n",
    "        \"\"\"Clean individual text\"\"\"\n",
    "        # Convert to lowercase\n",
    "        text = text.lower()\n",
    "        \n",
    "        # Remove special characters and numbers\n",
    "        text = re.sub(r'[^a-zA-Z\\s]', '', text)\n",
    "        \n",
    "        # Remove extra whitespace\n",
    "        text = re.sub(r'\\s+', ' ', text).strip()\n",
    "        \n",
    "        # Remove very short texts\n",
    "        if len(text) < 50:\n",
    "            return \"\"\n",
    "            \n",
    "        return text\n",
    "    \n",
    "    # Process in batches\n",
    "    processed_lyrics = []\n",
    "    for i in tqdm(range(0, len(lyrics), batch_size), desc=\"Processing batches\"):\n",
    "        batch = lyrics[i:i+batch_size]\n",
    "        processed_batch = [clean_text(lyric) for lyric in batch]\n",
    "        processed_lyrics.extend(processed_batch)\n",
    "    \n",
    "    # Filter out empty lyrics\n",
    "    processed_lyrics = [lyric for lyric in processed_lyrics if lyric]\n",
    "    \n",
    "    print(f\"✅ Preprocessing complete: {len(processed_lyrics):,} valid lyrics\")\n",
    "    return processed_lyrics\n",
    "\n",
    "# Load data\n",
    "data_path = \"../Lyrics_extraction/scraped_lyrics.csv\"\n",
    "df = load_and_preprocess_data(data_path, sample_size=1000 if gpu_memory_gb < 8 else None)\n",
    "\n",
    "# Extract lyrics\n",
    "lyrics = df['lyrics'].tolist()\n",
    "artists = df['artist'].tolist()\n",
    "song_titles = df['song_title'].tolist()\n",
    "\n",
    "# Preprocess lyrics\n",
    "processed_lyrics = preprocess_lyrics(lyrics)\n",
    "\n",
    "# Update dataframe to match processed lyrics\n",
    "df = df.iloc[:len(processed_lyrics)].copy()\n",
    "df['processed_lyrics'] = processed_lyrics\n",
    "\n",
    "print(f\"\\n📊 Final dataset: {len(df):,} songs ready for BERTopic\")\n",
    "print(f\"📊 {get_gpu_memory_usage()}\")"
   ]
